# Copy to .env. All values are optional — sensible defaults work out of the box.
# Notifications and poll interval are best configured in the Settings page (UI),
# but you can seed them here for first run.

# ── Notifications (Apprise) ───────────────────────────────────────────────────
# Comma- or newline-separated Apprise URLs. 100+ services supported. Examples:
#   ntfy://ntfy.sh/my-uscis-topic
#   tgram://bottoken/ChatID
#   discord://webhook_id/webhook_token
# Leave empty and configure later in the Settings page.
APPRISE_URLS=

# ── Polling ───────────────────────────────────────────────────────────────────
POLL_INTERVAL_HOURS=4

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:////app/data/uscis.db

# ── Fetching (FlareSolverr / Cloudflare) ──────────────────────────────────────
FLARESOLVERR_URL=http://flaresolverr:8191/v1
CF_SESSION_TTL_MINUTES=15

# ── Optional ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
